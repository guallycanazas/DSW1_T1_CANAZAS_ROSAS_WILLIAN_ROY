@model IEnumerable<DSW1_T1_CANAZAS_ROSAS_WILLIAN_ROY.Models.Libro>

@{
    ViewData["Title"] = "Listado de libros";
    var libros = Model.ToList();
    var autorBuscado = ViewBag.AutorBuscado as string ?? string.Empty;
}

<div class="d-flex flex-column flex-lg-row align-items-lg-end justify-content-between gap-3 mb-4">
    <div>
        <p class="text-uppercase text-primary fw-semibold small mb-1">Catálogo</p>
        <h1 class="display-6 fw-bold mb-1">Libros registrados</h1>
        <p class="text-secondary mb-0">Consulta, registra y mantiene los datos de la biblioteca.</p>
    </div>
    <a asp-action="Crear" class="btn btn-primary btn-lg">+ Registrar libro</a>
</div>

@if (ViewBag.Mensaje is string mensaje)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (ViewBag.Error is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<section class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3 p-md-4">
        <form asp-action="Buscar" method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-8 col-lg-9">
                <label for="autor" class="form-label fw-semibold">Buscar por autor</label>
                <input id="autor" name="autor" value="@autorBuscado" class="form-control form-control-lg"
                       maxlength="100" placeholder="Escriba el nombre completo o una parte" />
            </div>
            <div class="col-12 col-md-4 col-lg-3 d-flex gap-2">
                <button type="submit" class="btn btn-dark btn-lg flex-grow-1">Buscar</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Limpiar</a>
            </div>
        </form>
    </div>
</section>

<section class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h2 class="h5 mb-0">@(autorBuscado.Length > 0 ? $"Resultados para “{autorBuscado}”" : "Todos los libros")</h2>
        <span class="badge text-bg-primary rounded-pill">@libros.Count registro(s)</span>
    </div>

    @if (libros.Count == 0)
    {
        <div class="card-body text-center py-5">
            <div class="empty-icon mb-3" aria-hidden="true">▤</div>
            <h3 class="h5">@(autorBuscado.Length > 0 ? "No se encontraron coincidencias" : "Todavía no hay libros registrados")</h3>
            <p class="text-secondary mb-0">@(autorBuscado.Length > 0 ? "Pruebe con otra parte del nombre del autor." : "Use el botón “Registrar libro” para agregar el primero.")</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="ps-4">Código</th>
                        <th scope="col">Nombre del libro</th>
                        <th scope="col">Autor</th>
                        <th scope="col">Editorial</th>
                        <th scope="col">ISDN</th>
                        <th scope="col" class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var libro in libros)
                    {
                        <tr>
                            <td class="ps-4 text-secondary">#@libro.Id</td>
                            <td class="fw-semibold">@libro.NombreLibro</td>
                            <td>@libro.Autor</td>
                            <td>@libro.NombreEditorial</td>
                            <td><span class="font-monospace small">@libro.ISDN</span></td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-2">
                                    <a asp-action="Editar" asp-route-id="@libro.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    <form asp-action="Eliminar" asp-route-id="@libro.Id" method="post"
                                          onsubmit="return confirm('¿Confirma que desea eliminar este libro?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
