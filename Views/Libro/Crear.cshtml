@model DSW1_T1_CANAZAS_ROSAS_WILLIAN_ROY.Models.Libro

@{
    ViewData["Title"] = "Registrar libro";
}

<div class="form-shell">
    <a asp-action="Index" class="text-decoration-none small">← Volver al listado</a>
    <div class="mt-3 mb-4">
        <p class="text-uppercase text-primary fw-semibold small mb-1">Nuevo registro</p>
        <h1 class="display-6 fw-bold mb-1">Registrar libro</h1>
        <p class="text-secondary mb-0">Complete todos los campos para guardar el libro.</p>
    </div>

    @if (ViewBag.Error is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <form asp-action="Crear" method="post" class="card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="NombreLibro" class="form-label fw-semibold"></label>
                <input asp-for="NombreLibro" class="form-control form-control-lg" placeholder="Ej. Cien años de soledad" autofocus />
                <span asp-validation-for="NombreLibro" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Autor" class="form-label fw-semibold"></label>
                <input asp-for="Autor" class="form-control" placeholder="Nombres y apellidos del autor" />
                <span asp-validation-for="Autor" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NombreEditorial" class="form-label fw-semibold"></label>
                <input asp-for="NombreEditorial" class="form-control" placeholder="Nombre de la editorial" />
                <span asp-validation-for="NombreEditorial" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ISDN" class="form-label fw-semibold"></label>
                <input asp-for="ISDN" class="form-control" placeholder="Código ISDN" />
                <span asp-validation-for="ISDN" class="text-danger small"></span>
            </div>
            <div class="d-flex flex-column flex-sm-row gap-2 justify-content-end">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary px-4">Guardar libro</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
